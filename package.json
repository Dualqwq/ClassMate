{
  "name": "classmate",
  "displayName": "ClassMate",
  "description": "AI tutor for C/C++ beginners",
  "version": "0.0.1",
  "type": "commonjs",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "C++",
    "education",
    "AI",
    "tutor",
    "debug"
  ],
  "activationEvents": [
    "onLanguage:cpp",
    "onView:classmate.chatView",
    "onCommand:classmate.openChat",
    "onCommand:classmate.openChatPanel",
    "onCommand:classmate.focusChatView",
    "onCommand:classmate.hideChatView",
    "onCommand:classmate.toggleChatContainer",
    "onCommand:classmate.compile",
    "onCommand:classmate.runCode",
    "onCommand:classmate.explainSelection",
    "onCommand:classmate.explainError",
    "onCommand:classmate.debugJourney",
    "onCommand:classmate.setupApiKey"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "classmate.openChat",
        "title": "Open Chat",
        "category": "ClassMate",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "classmate.compile",
        "title": "Compile",
        "category": "ClassMate",
        "icon": "$(play)"
      },
      {
        "command": "classmate.runCode",
        "title": "Compile & Run",
        "category": "ClassMate",
        "icon": "$(run)"
      },
      {
        "command": "classmate.explainSelection",
        "title": "Explain Selected Code",
        "category": "ClassMate",
        "icon": "$(lightbulb)"
      },
      {
        "command": "classmate.explainError",
        "title": "Explain Error",
        "category": "ClassMate",
        "icon": "$(error)"
      },
      {
        "command": "classmate.debugJourney",
        "title": "Open Debug Journey",
        "category": "ClassMate",
        "icon": "$(history)"
      },
      {
        "command": "classmate.openChatPanel",
        "title": "Open Chat in Panel",
        "category": "ClassMate",
        "icon": "$(screen-full)"
      },
      {
        "command": "classmate.focusChatView",
        "title": "Focus Chat in Sidebar",
        "category": "ClassMate",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "classmate.toggleChatContainer",
        "title": "Toggle Chat Container",
        "category": "ClassMate"
      },
      {
        "command": "classmate.hideChatView",
        "title": "Hide Chat",
        "category": "ClassMate",
        "icon": "$(chevron-down)"
      },
      {
        "command": "classmate.setupApiKey",
        "title": "Set API Key",
        "category": "ClassMate",
        "icon": "$(key)"
      }
    ],
    "configuration": {
      "title": "ClassMate",
      "properties": {
        "classmate.defaultContainer": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "view",
            "panel"
          ],
          "enumDescriptions": [
            "Automatically choose sidebar for short chat/hints and panel for long explanations",
            "Always open chat in the sidebar view",
            "Always open chat in the editor panel"
          ],
          "description": "Default container for chat responses"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "classmate-sidebar",
          "title": "ClassMate",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "classmate-sidebar": [
        {
          "id": "classmate.chatView",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        { "command": "classmate.openChat" },
        { "command": "classmate.openChatPanel" },
        { "command": "classmate.focusChatView" },
        { "command": "classmate.hideChatView" },
        { "command": "classmate.toggleChatContainer" },
        { "command": "classmate.compile" },
        { "command": "classmate.runCode" },
        { "command": "classmate.explainSelection" },
        {
          "command": "classmate.explainError",
          "when": "false"
        },
        { "command": "classmate.debugJourney" },
        { "command": "classmate.setupApiKey" }
      ],
      "view/title": [
        {
          "command": "classmate.openChatPanel",
          "group": "navigation@1",
          "when": "view == classmate.chatView"
        },
        {
          "command": "classmate.hideChatView",
          "group": "navigation@2",
          "when": "view == classmate.chatView"
        }
      ],
      "editor/title": [
        {
          "command": "classmate.compile",
          "group": "navigation@1",
          "when": "editorLangId == cpp"
        },
        {
          "command": "classmate.runCode",
          "group": "navigation@2",
          "when": "editorLangId == cpp"
        }
      ],
      "editor/context": [
        {
          "command": "classmate.explainSelection",
          "group": "2_classmate@1",
          "when": "editorHasSelection && editorLangId == cpp"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run compile:ext && npm run build:webview",
    "compile:ext": "webpack",
    "watch": "npm run compile:ext && npm run watch:all",
    "watch:all": "concurrently \"npm:watch:ext\" \"npm:watch:webview\"",
    "watch:ext": "webpack --watch",
    "build:webview": "node webview/esbuild.js",
    "watch:webview": "node webview/esbuild.js --watch",
    "package": "webpack --mode production --devtool hidden-source-map && npm run build:webview",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "openai": "^4.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.2",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "ts-loader": "^9.6.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
