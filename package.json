{
  "name": "classmate",
  "displayName": "ClassMate",
  "description": "AI tutor for C/C++ beginners",
  "version": "0.0.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dualqwq/ClassMate.git"
  },
  "type": "commonjs",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "keywords": [
    "C++",
    "education",
    "AI",
    "tutor",
    "debug"
  ],
  "activationEvents": [
    "onLanguage:c",
    "onLanguage:cpp",
    "onView:classmate.chatView",
    "onView:classmate.debugJourneyTree",
    "onCommand:classmate.openChat",
    "onCommand:classmate.openChatPanel",
    "onCommand:classmate.focusChatView",
    "onCommand:classmate.hideChatView",
    "onCommand:classmate.toggleChatContainer",
    "onCommand:classmate.compile",
    "onCommand:classmate.runCode",
    "onCommand:classmate.explainSelection",
    "onCommand:classmate.explainError",
    "onCommand:classmate.debugJourney",
    "onCommand:classmate.refreshDebugJourneyTree",
    "onCommand:classmate.closeDebugJourneyTree",
    "onCommand:classmate.openDebugNodeDiff",
    "onCommand:classmate.exportDebugNotebook",
    "onCommand:classmate.setupApiKey"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "classmate.openChat",
        "title": "Open Chat",
        "category": "ClassMate",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "classmate.compile",
        "title": "Compile",
        "category": "ClassMate",
        "icon": "$(play)"
      },
      {
        "command": "classmate.runCode",
        "title": "Compile & Run",
        "category": "ClassMate",
        "icon": "$(run)"
      },
      {
        "command": "classmate.explainSelection",
        "title": "Explain Selected Code",
        "category": "ClassMate",
        "icon": "$(lightbulb)"
      },
      {
        "command": "classmate.explainError",
        "title": "Explain Error",
        "category": "ClassMate",
        "icon": "$(error)"
      },
      {
        "command": "classmate.debugJourney",
        "title": "Open Debug Journey",
        "category": "ClassMate",
        "icon": "$(history)"
      },
      {
        "command": "classmate.refreshDebugJourneyTree",
        "title": "Refresh Debug Journey",
        "category": "ClassMate",
        "icon": "$(refresh)"
      },
      {
        "command": "classmate.closeDebugJourneyTree",
        "title": "Close Debug Journey",
        "category": "ClassMate",
        "icon": "$(close)"
      },
      {
        "command": "classmate.openDebugNodeDiff",
        "title": "Open Diff",
        "category": "ClassMate",
        "icon": "$(diff)"
      },
      {
        "command": "classmate.exportDebugNotebook",
        "title": "Export Debug Notebook",
        "category": "ClassMate",
        "icon": "$(export)"
      },
      {
        "command": "classmate.openChatPanel",
        "title": "Open Chat in Panel",
        "category": "ClassMate",
        "icon": "$(screen-full)"
      },
      {
        "command": "classmate.focusChatView",
        "title": "Focus Chat in Sidebar",
        "category": "ClassMate",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "classmate.toggleChatContainer",
        "title": "Toggle Chat Container",
        "category": "ClassMate"
      },
      {
        "command": "classmate.hideChatView",
        "title": "Hide Chat",
        "category": "ClassMate",
        "icon": "$(chevron-down)"
      },
      {
        "command": "classmate.setupApiKey",
        "title": "Set API Key",
        "category": "ClassMate",
        "icon": "$(key)"
      }
    ],
    "configuration": {
      "title": "ClassMate",
      "properties": {
        "classmate.defaultContainer": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "view",
            "panel"
          ],
          "enumDescriptions": [
            "Automatically choose sidebar for short chat/hints and panel for long explanations",
            "Always open chat in the sidebar view",
            "Always open chat in the editor panel"
          ],
          "description": "Default container for chat responses"
        },
        "classmate.enabledLanguages": {
          "type": "array",
          "default": [
            "c",
            "cpp"
          ],
          "items": {
            "type": "string"
          },
          "description": "Language identifiers for which ClassMate features (explain selection, compile/run buttons) are enabled"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "classmate-sidebar-v2",
          "title": "ClassMate",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "classmate-sidebar-v2": [
        {
          "id": "classmate.chatView",
          "name": "Chat",
          "type": "webview",
          "when": "classmate.chatContainer == 'view'",
          "initialSize": 2
        },
        {
          "id": "classmate.debugJourneyTree",
          "name": "Debug Journey",
          "type": "tree",
          "when": "classmate.debugJourneyTree.enabled",
          "initialSize": 1
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "classmate.openChat"
        },
        {
          "command": "classmate.openChatPanel"
        },
        {
          "command": "classmate.focusChatView"
        },
        {
          "command": "classmate.hideChatView"
        },
        {
          "command": "classmate.toggleChatContainer"
        },
        {
          "command": "classmate.compile"
        },
        {
          "command": "classmate.runCode"
        },
        {
          "command": "classmate.explainSelection"
        },
        {
          "command": "classmate.explainError",
          "when": "false"
        },
        {
          "command": "classmate.debugJourney"
        },
        {
          "command": "classmate.exportDebugNotebook"
        },
        {
          "command": "classmate.setupApiKey"
        }
      ],
      "view/title": [
        {
          "command": "classmate.openChat",
          "group": "navigation@0",
          "when": "view == classmate.debugJourneyTree && classmate.chatContainer == 'hidden'"
        },
        {
          "command": "classmate.openChatPanel",
          "group": "navigation@1",
          "when": "view == classmate.chatView"
        },
        {
          "command": "classmate.hideChatView",
          "group": "navigation@2",
          "when": "view == classmate.chatView"
        },
        {
          "command": "classmate.refreshDebugJourneyTree",
          "group": "navigation@1",
          "when": "view == classmate.debugJourneyTree"
        },
        {
          "command": "classmate.closeDebugJourneyTree",
          "group": "navigation@2",
          "when": "view == classmate.debugJourneyTree"
        },
        {
          "command": "classmate.exportDebugNotebook",
          "group": "navigation@3",
          "when": "view == classmate.debugJourneyTree"
        }
      ],
      "view/item/context": [
        {
          "command": "classmate.openDebugNodeDiff",
          "group": "inline@1",
          "when": "view == classmate.debugJourneyTree && viewItem == codeModifiedNode"
        },
        {
          "command": "classmate.openDebugNodeDiff",
          "group": "9_debugJourney@1",
          "when": "view == classmate.debugJourneyTree && viewItem == codeModifiedNode"
        }
      ],
      "editor/title": [
        {
          "command": "classmate.compile",
          "group": "navigation@1",
          "when": "editorLangId == c || editorLangId == cpp"
        },
        {
          "command": "classmate.runCode",
          "group": "navigation@2",
          "when": "editorLangId == c || editorLangId == cpp"
        }
      ],
      "editor/context": [
        {
          "command": "classmate.explainSelection",
          "group": "2_classmate@1",
          "when": "editorHasSelection && (editorLangId == c || editorLangId == cpp)"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run compile:ext && npm run build:webview",
    "compile:ext": "webpack",
    "watch": "npm run compile:ext && npm run watch:all",
    "watch:all": "concurrently \"npm:watch:ext\" \"npm:watch:webview\"",
    "watch:ext": "webpack --watch",
    "build:webview": "node webview/esbuild.js",
    "watch:webview": "node webview/esbuild.js --watch",
    "package": "webpack --mode production --devtool hidden-source-map && npm run build:webview",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@langchain/core": "^1.2.3",
    "@langchain/langgraph": "^1.4.8",
    "diff": "^8.0.4",
    "gray-matter": "^4.0.3",
    "openai": "^4.77.0",
    "pdf-parse": "^1.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.5.0",
    "remark-gfm": "^4.0.0",
    "vsce": "^2.15.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-syntax-highlighter": "^15.5.11",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.24.2",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.6"
  }
}
